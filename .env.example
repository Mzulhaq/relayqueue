# Compose supplies the internal PostgreSQL URL. For direct Python processes,
# set RQ_DATABASE_URL=sqlite:///./relayqueue.db in each terminal.
RQ_INGRESS_SECRET=replace-with-a-distinct-random-secret-at-least-32-chars
RQ_DESTINATION_SECRET=replace-with-another-distinct-random-secret-32chars
RQ_ADMIN_TOKEN=replace-with-a-third-distinct-random-token-at-least-32chars
RQ_DESTINATION_URL=https://example.invalid/webhook
RQ_ALLOW_INSECURE_HTTP=false
RQ_MAX_ATTEMPTS=5
RQ_RETRY_BASE_SECONDS=2
RQ_RETRY_MAX_SECONDS=60
RQ_REQUEST_TIMEOUT_SECONDS=5
RQ_LEASE_SECONDS=30
RQ_POLL_INTERVAL_SECONDS=0.5
RQ_MAX_BODY_BYTES=65536
RQ_SIGNATURE_TOLERANCE_SECONDS=300
